  Divida          Media   condicional     ['pe_do_proximo_feitico']
  Queima-Roupa (Projétil)Media   permanente      ['distancia_alvo']
  Recuo           Media   ate o proximo   ['corpo_condicao_menor']
  Sangra          Media   na hora         ['vida']
  Sem Volta       Media   condicional     ['proximo_turno_inteiro']

