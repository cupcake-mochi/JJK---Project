        "largura": 233.858,
        "altura": 52.8,
        "modo": "duas-colunas",
        "faixa": "106-0",
        "gerado": false,
        "texto": "O uso é gasto na declaração. A Sequência e os custos permanecem consumidos. Uma armação já desfeita não pode ser recuperada por esta habilidade."
      },
      {
        "pagina": 106,
        "capitulo": 6,
        "bloco": "vanguarda--van-yumi-avanco",
