        "modo": "duas-colunas",
        "faixa": "106-0",
        "gerado": false,
        "texto": "Isso pode acontecer depois de qualquer evento da Soltura Simples ou imediatamente antes do seu próximo turno, mesmo fora do evento marcado. Use a Reação ainda disponível e faça o ataque contra o mesmo alvo."
      },
      {
        "pagina": 106,
        "capitulo": 6,
        "bloco": "vanguarda--van-yumi-avanco",
        "tipo": "body",
        "papel": "texto",
        "tratamento_hierarquia": null,
        "nivel_editorial": null,
        "contexto": "Vanguarda / Batedor: Yumi",
        "x": 307.559,
