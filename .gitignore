# Backup da pasta antes da reorganizacao para git. Fica no disco, nao no repositorio.
_backup/

# Onde o assistente poe o que precisa sumir — ele nao consegue apagar neste mount.
# Apague a pasta a mao quando quiser.
_to_delete/

# O gerador do manual instala dependencia local
manual/gerador/node_modules/
manual/gerador/package-lock.json

# O .docx gerado dentro da pasta do gerador e copia de trabalho —
# o que vale e o de manual/Fundamento-MANUAL-v7.docx
manual/gerador/Fundamento-MANUAL-v7.docx

# Python
__pycache__/
*.pyc
.venv/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Temporarios de editor
*~
*.swp
.~lock.*#

# A mensagem de commit que o assistente deixa pronta. O subir.sh usa e apaga —
# ela e passagem, nao material do repositorio.
mensagem-de-commit.txt
